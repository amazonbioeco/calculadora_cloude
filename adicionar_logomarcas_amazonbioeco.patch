diff --git a/public/styles.css b/public/styles.css
--- a/public/styles.css
+++ b/public/styles.css
@@
 .brand { display: flex; align-items: center; gap: 1rem; }
-.brand__mark { display: grid; width: 64px; height: 64px; place-items: center; border-radius: 18px; background: white; box-shadow: 0 12px 30px rgba(0,0,0,.16); }
-.brand__mark svg { width: 44px; fill: var(--green-600); }
-.brand__mark .brand__vein { fill: none; stroke: white; stroke-width: 3; stroke-linecap: round; }
+.brand__logo {
+  display: block;
+  flex: 0 0 auto;
+  width: 92px;
+  height: 92px;
+  object-fit: contain;
+  padding: .35rem;
+  border-radius: 20px;
+  background: white;
+  box-shadow: 0 12px 30px rgba(0,0,0,.16);
+}
@@
 .footer { color: rgba(255,255,255,.86); background: var(--green-900); }
+.sponsors {
+  padding-top: 1.5rem;
+  text-align: center;
+}
+.sponsors__title {
+  margin: 0 0 .8rem;
+  color: rgba(255,255,255,.72);
+  font-size: .72rem;
+  font-weight: 850;
+  letter-spacing: .1em;
+  text-transform: uppercase;
+}
+.sponsors__image {
+  display: block;
+  width: min(100%, 760px);
+  height: auto;
+  max-height: 110px;
+  margin-inline: auto;
+  padding: .6rem 1rem;
+  object-fit: contain;
+  border-radius: 12px;
+  background: white;
+}
 .footer__content { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.8rem; }
